rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /admin/{file=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == 'example-admin-uid'
        && request.auth.token.admin == true;
    }
    match /{file=**} { allow read, write: if false; }
  }
}
