# Copier ce fichier en .env dans le même dossier. Ne jamais partager ni publier .env.
# Clé API TMDB v3 (32 caractères), PAS le jeton Firebase ni une clé privée Firebase.
TMDB_API_KEY=
# Le lecteur Vidmoly par iframe ne nécessite aucune clé API dans cette intégration.
# VIDMOLY_API_KEY peut rester dans le .env privé existant, mais n'est pas utilisée :
# aucune API Vidmoly ne sera appelée sans documentation officielle vérifiée.
MOVIX_PORT=4180
MOVIX_PUBLIC_ORIGIN=http://localhost:4180
# En production, utiliser les variables secrètes de l'hébergeur plutôt qu'un fichier livré au public.
